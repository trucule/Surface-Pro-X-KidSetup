# Copy to C:\ProgramData\KidTablet\.env to let Draw With Me learn drawings it does not have.
# Without this file, Draw With Me uses its built-in drawings and library.js only.
ANTHROPIC_API_KEY=sk-ant-...
# Optional:
# DRAW_DAILY_LIMIT=25
# DRAW_MODEL=claude-sonnet-5-5

# Story Maker (optional). Stories are written live by Claude with the key above; without it a built-in story is used.
# STORY_MODEL=claude-haiku-4-5-20251001
# Live voices, one per character. Azure Speech (region + key) or OpenAI. Without these, Windows voices are used.
# TTS_PROVIDER=azure
# TTS_REGION=eastus
# TTS_KEY=...
